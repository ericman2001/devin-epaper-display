  (text "J6 IO35-37 and IO47/48 assume non-octal-PSRAM, non-R16V module" (exclude_from_sim no) (at 50.800 965.200 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "9c9d82b7-3198-4bba-bb17-e722c714956a"))
  (text "J3 REQUIRES a LiPo cell with an integrated protection PCM. Nothing on this board" (exclude_from_sim no) (at 50.800 969.010 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "e8d9e09f-45eb-4e4c-9919-be7dc02732d6"))
  (text "   stops over-discharge, and D6 relies on that PCM to clear a reverse-polarity fault." (exclude_from_sim no) (at 50.800 972.820 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "29d5a10b-f99b-4fe5-9f1c-dc4a97e3e0ba"))
  (text "   Verify cell polarity before first plug-in: JST-PH wiring varies between vendors." (exclude_from_sim no) (at 50.800 976.630 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "435679a6-acb2-4cf6-b7c1-0ffc972b8d0f"))
  (text "U3 (SOT-23-5, 1=IN 2=GND 3=EN 4=NC 5=OUT) accepts TLV75733PDBVR / AP2112K-3.3 /" (exclude_from_sim no) (at 50.800 980.440 0)
